# Normalize text files to LF across platforms
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary

# LFS artifacts
editor/editor_exe/**/*.app/** filter=lfs diff=lfs merge=lfs -text
editor/editor_exe/**/*.exe filter=lfs diff=lfs merge=lfs -text
editor/editor_exe/**/*.dmg filter=lfs diff=lfs merge=lfs -text
editor/editor_exe/**/*.zip filter=lfs diff=lfs merge=lfs -text
